{
  "name": "personal-accounting",
  "version": "1.1.0",
  "private": true,
  "description": "一个面向个人预算管理、账单记录和消费分析的全栈应用",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev:client": "npm run dev --workspace accounting-client",
    "dev:server": "npm run dev --workspace accounting-server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "engines": {
    "node": ">=20.19"
  },
  "overrides": {
    "dottie": "2.0.7"
  }
}
